{
  "dataset_id": "day03_v2_research_group",
  "dataset_role": "group",
  "description": "Case do nhóm MeoConSatThu tự viết: 5 single turn + 5 multi turn. Cover tool mới hn_search, args (timeframe=month, search_type+limit, handle mapping), out-of-scope, xác nhận trước khi gửi và đổi ý nhiều lượt.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_hn_search_routing",
      "phase": "B",
      "suite": "group",
      "query": "Trên Hacker News mọi người đang bàn gì về LLM?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "hn_search",
            "args": {
              "query": "LLM"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_new_tool",
        "difficulty": "easy",
        "what_it_tests": "Nhắc Hacker News → route tới tool mới hn_search, không phải lookup hay social_search; query chỉ chứa chủ đề."
      }
    },
    {
      "id": "G02_timeframe_month",
      "phase": "B",
      "suite": "group",
      "query": "Tin tức về Nvidia trong tháng này",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {
              "query": "Nvidia",
              "topic": "news",
              "timeframe": "month"
            }
          }
        ]
      },
      "metadata": {
        "skill": "arg_timeframe_month",
        "difficulty": "medium",
        "what_it_tests": "'tháng này' → timeframe=month (base chỉ test day/week), topic=news, query chỉ là tên chủ thể."
      }
    },
    {
      "id": "G03_handle_mapping_new_person",
      "phase": "B",
      "suite": "group",
      "query": "Cho mình 3 tweet mới nhất của Satya Nadella",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {
              "screenname": "satyanadella",
              "limit": 3
            }
          }
        ]
      },
      "metadata": {
        "skill": "arg_handle_mapping",
        "difficulty": "medium",
        "what_it_tests": "Map một người nổi tiếng không có trong base (Satya Nadella → satyanadella), handle không có @, limit=3."
      }
    },
    {
      "id": "G04_out_of_scope_translation",
      "phase": "B",
      "suite": "group",
      "query": "Dịch giúp mình câu 'good morning' sang tiếng Nhật",
      "failure_type": "out_of_scope",
      "expect": {
        "no_tool": true,
        "behavior": "refuse"
      },
      "metadata": {
        "skill": "out_of_scope_translation",
        "difficulty": "easy",
        "what_it_tests": "Yêu cầu dịch thuật ngoài phạm vi research → không gọi tool nào (đặc biệt không gọi send)."
      }
    },
    {
      "id": "G05_top_and_limit_args",
      "phase": "B",
      "suite": "group",
      "query": "Lấy 10 tweet nổi bật nhất về Gemini",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "social_search",
            "args": {
              "query": "Gemini",
              "search_type": "Top",
              "limit": 10
