          }
        ]
      },
      "metadata": {
        "skill": "arg_search_type_and_limit",
        "difficulty": "medium",
        "what_it_tests": "Kết hợp 2 arg trong một câu: 'nổi bật nhất' → search_type=Top và '10 tweet' → limit=10."
      }
